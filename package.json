{
  "name": "@weblings/grille",
  "version": "0.1.0-dev.2",
  "description": "Shared design tokens and React Aria components for the weblings projects",
  "license": "MIT",
  "type": "module",
  "repository": "github:weblings/GrilleDS",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/generated/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./ui.css": "./dist/ui.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "dev": "npm run build:tokens && vite --open /playground/",
    "build": "npm run build:tokens && vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:css && npm run lint:boundary",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:boundary": "node scripts/check-ui-boundary.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "react-aria-components": "1.22.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "style-dictionary": "5.7.1",
    "stylelint": "17.16.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "vitest-axe": "0.1.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
